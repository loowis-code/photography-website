{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "photography-website",
    "compatibility_date": "2025-04-01",
    "compatibility_flags": ["nodejs_compat"],
    "main": "src/server.ts",
    "observability": {
        "enabled": true,
    },
    "r2_buckets": [
        {
            "binding": "R2_BUCKET",
            "bucket_name": "photography-images",
        },
    ],
}
